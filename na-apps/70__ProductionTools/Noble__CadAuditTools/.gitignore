# =============================================================================
# NOBLE CAD AUDIT TOOLS — .gitignore
# =============================================================================

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/
*.egg

# --- Local Project Cache (DWG conversions and audited DXF saves) -------------
04__LocalProjectCache/01__TempCache__DwgToDxfConversions/*.dxf
04__LocalProjectCache/01__TempCache__DwgToDxfConversions/*.dwg
04__LocalProjectCache/02__SavedProjects__AuditedDxfFiles/*.dxf
04__LocalProjectCache/02__SavedProjects__AuditedDxfFiles/*.dwg

# Keep the .gitkeep placeholder files
!04__LocalProjectCache/**/.gitkeep

# --- OS Artifacts -------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- IDE & Editor -------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- Node (if ever used) -----------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
