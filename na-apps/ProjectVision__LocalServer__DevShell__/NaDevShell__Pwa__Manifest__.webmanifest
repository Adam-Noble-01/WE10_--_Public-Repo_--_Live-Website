{
    "name": "Noble Architecture Studio",
    "short_name": "NA Studio",
    "description": "One local entry point for every Noble Architecture project - the gallery, Project Admin, PlanVision and TrueVision 3D in a single window.",
    "categories": ["business", "productivity"],
    "lang": "en-GB",
    "dir": "ltr",
    "id": "/",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
