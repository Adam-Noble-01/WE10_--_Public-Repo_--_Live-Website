{
    "appName"                      : "NaProjectAdmin",
    "appVersion"                   : "0.6.5",
    "appAuthor"                    : "Adam Noble - Noble Architecture",
    "appDescription"               : "Project Admin & Documentation System",
    "appDomain"                    : "https://www.noble-architecture.com/",

    "AppConfig": {
        "devMode"                              : false,
        "devMode_ShowDebugLogs"                : false,
        "devMode_BypassAuth"                   : false,

        "Paths": {
            "coreAppBase"                      : "/na-apps/10__NaProjectAdmin__DocumentSystem__CoreAppCode/",
            "projectPortalBase"                : "/na-project-portal/",
            "commonAssetsBase"                 : "/na-apps/01__Assets__NaApps__CommonAssets/",
            "cdnBase"                          : "https://cdn.noble-architecture.com/"
        },

        "ProjectLoading": {
            "defaultYear"                      : "26",
            "projectFolderPattern"             : "{year}-Projects/{projectCode}",
            "projectAdminFolder"               : "10__ProjectAdmin__AppContent",
            "quotationFile"                    : "ProjectAdmin__Quotations__.json",
            "invoiceFile"                      : "ProjectAdmin__Invoices__.json",
            "specialTermsFile"                 : "ProjectAdmin__SpecialTerms__.json",
            "projectConfigFile"                : "ProjectAdmin__ProjectConfig__.json"
        },

        "Features": {
            "QuotationSystem": {
                "enabled"                      : true,
                "showVat"                      : true,
                "vatRate"                      : 0,
                "currencySymbol"               : "£",
                "currencyCode"                 : "GBP",
                "validityDays"                 : 30
            },
            "TermsSystem": {
                "enabled"                      : true,
                "showSpecialTermsFirst"        : true,
                "generalTermsFile"             : "DocumentSystem__GeneralTerms__.html"
            },
            "SignatureSystem": {
                "enabled"                      : true,
                "requireBothSignatures"        : false,
                "requirePerContractSignatures" : true,
                "canvasWidth"                  : 600,
                "canvasHeight"                 : 200,
                "strokeColour"                 : "#000000",
                "strokeWidth"                  : 2
            },
            "Authentication": {
                "enabled"                      : true,
                "pinMinLength"                 : 4,
                "pinMaxLength"                 : 6,
                "sessionTimeout"               : 3600000,
                "maxAttempts"                  : 5,
                "lockoutDuration"              : 300000
            },
            "InvoiceSystem": {
                "enabled"                      : true,
                "dueDays"                      : 7,
                "currencySymbol"               : "£",
                "currencyCode"                 : "GBP",
                "invoiceFile"                  : "ProjectAdmin__Invoices__.json",
                "standardNote"                 : "Thank you for your business. We hope you are satisfied with the service received from Noble Architecture.",
                "passwordResetEmail"           : "Billing@Noble-Architecture.com",
                "passwordResetNote"            : "If you have any issues with this invoice, please contact"
            },
            "CoverLetterSystem": {
                "enabled"                      : true,
                "showAsDefaultView"            : true,
                "signatureGraphic"             : "NaBrandGraphic__EmailSignature__.png"
            }
        },

        "CloudflareConfig": {
            "enabled"                          : true,
            "workerBaseUrl"                    : "https://na-projectadmin-api.adam-fb3.workers.dev/",
            "workerBaseUrlCustom"              : "https://api.noble-architecture.com/",
            "authEndpoint"                     : "projectadmin/auth",
            "signatureEndpoint"                : "projectadmin/signature",
            "signatureInitialCheckEndpoint"    : "projectadmin/signature-initial-check",
            "clientDataEndpoint"               : "projectadmin/clientdata",
            "r2BucketPrefix"                   : "NaProjectPortal/",
            "accountId"                        : "fb32e89aeb7dce82f8391f6496ec8b34"
        },

        "ContractRegistry": {
            "markdownSourcePath"               : "10__GeneralTerms__Markdown/",
            "defaults"                         : ["general-business", "concept-design"],
            "available": {
                "general-business": {
                    "id"                       : "general-business",
                    "name"                     : "General Business Terms",
                    "shortName"                : "General Terms",
                    "file"                     : "10_00__ApprovedStandardTerms__GeneralBuisinesTerms__.md",
                    "description"              : "Standard terms of engagement with Noble Architecture",
                    "required"                 : true,
                    "order"                    : 0
                },
                "concept-design": {
                    "id"                       : "concept-design",
                    "name"                     : "Concept Design Stage",
                    "shortName"                : "Concept Design",
                    "file"                     : "10_01__ApprovedStandardTerms__ConceptStage__DesignPhase-02__.md",
                    "description"              : "Terms for Design Phase 01 - Concept Design",
                    "required"                 : false,
                    "order"                    : 1
                },
                "planning-approval": {
                    "id"                       : "planning-approval",
                    "name"                     : "Planning Approval Stage",
                    "shortName"                : "Planning",
                    "file"                     : "10_02__ApprovedStandardTerms__PlanningApproval__DesignPhase-02__.md",
                    "description"              : "Terms for Design Phase 02 - Planning Approval",
                    "required"                 : false,
                    "order"                    : 2
                },
                "building-regulations": {
                    "id"                       : "building-regulations",
                    "name"                     : "Building Regulations Stage",
                    "shortName"                : "Building Regs",
                    "file"                     : "10_03__ApprovedStandardTerms__BuildingRegulations__DesignPhase-03__.md",
                    "description"              : "Terms for Design Phase 03 - Building Regulations",
                    "required"                 : false,
                    "order"                    : 3
                },
                "project-management": {
                    "id"                       : "project-management",
                    "name"                     : "Project Management Stage",
                    "shortName"                : "Project Mgmt",
                    "file"                     : "10_04__ApprovedStandardTerms__ProjectManagement__DesignPhase-04__.md",
                    "description"              : "Terms for Design Phase 04 - Project Management",
                    "required"                 : false,
                    "order"                    : 4
                },
                "building-surveying": {
                    "id"                       : "building-surveying",
                    "name"                     : "Building Surveying Service",
                    "shortName"                : "Surveying",
                    "file"                     : "10_10__ApprovedStandardTerms__BuildingSurveyingSurvey__.md",
                    "description"              : "Terms for Measured Building Survey services",
                    "required"                 : false,
                    "order"                    : 10
                },
                "planvision-app": {
                    "id"                       : "planvision-app",
                    "name"                     : "PlanVision App Terms",
                    "shortName"                : "PlanVision",
                    "file"                     : "10_20__ApprovedStandardTerms__PlanVisionApp__.md",
                    "description"              : "Terms for PlanVision online drawings viewer",
                    "required"                 : false,
                    "order"                    : 20
                },
                "truevision-app": {
                    "id"                       : "truevision-app",
                    "name"                     : "TrueVision App Terms",
                    "shortName"                : "TrueVision",
                    "file"                     : "10_30__ApprovedStandardTerms__TrueVisionApp__.md",
                    "description"              : "Terms for TrueVision 3D model viewer",
                    "required"                 : false,
                    "order"                    : 30
                },
                "project-vision": {
                    "id"                       : "project-vision",
                    "name"                     : "ProjectVision App Terms",
                    "shortName"                : "ProjectVision",
                    "file"                     : "10_40__ApprovedStandardTerms__ProjectVision__.md",
                    "description"              : "Terms for ProjectVision project overview tool",
                    "required"                 : false,
                    "order"                    : 40
                }
            }
        },

        "UI": {
            "brandColour"                      : "#555041",
            "sidebarCollapsedByDefault"        : false,
            "animationsEnabled"                : true,
            "showLoadingOverlay"               : true
        },

        "AuditSettings": {
            "captureIpAddress"                 : true,
            "captureUserAgent"                 : true,
            "captureBrowserFingerprint"        : true,
            "generateDocumentHash"             : true
        }
    },

    "CompanyDetails": {
        "companyName"                          : "Noble Architecture",
        "companyAddress"                       : "Concept Design Service Team",
        "companyEmail"                         : "Billing@noble-architecture.com",
        "companyPhone"                         : "",
        "companyWebsite"                       : "https://www.noble-architecture.com",
        "companyRegistration"                  : ""
    }
}
