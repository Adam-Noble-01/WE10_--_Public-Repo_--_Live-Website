        "EdgeDefaults__Description"  : "What a row below inherits when it names no edge style of its own, and what a category the model loaded that this file has never heard of reads as. Black, solid, full weight: visible and obviously unstyled, rather than invisible.",
        "EdgeDefaults__WeightFactor" : 1.00,
        "EdgeDefaults__Colour"       : "black",
        "EdgeDefaults__LineType"     : "solid"
    },

