{
    "LayoutEditor__KeyMappings__Description"   : "Every mouse, wheel, keyboard and touch binding the Layout Editor listens for. Nothing in the control modules is hard-coded to a button or a key, so this file is the single place a binding changes. It is shaped to be handed to a user personalisation screen later: each binding carries an Id, a human Label and an Enabled flag, so a saved user override can be merged over the top of this file without the control code changing at all.",
    "LayoutEditor__KeyMappings__SchemaVersion" : 1,

    "LayoutEditor__KeyMappings__Notes" : [
        "Buttons are named Left, Middle and Right (mouse button 0, 1 and 2).",
        "Modifiers are named Ctrl, Shift, Alt, Meta and Space. Space is the held space bar, tracked by the PC controls module.",
        "ModifierMatch Exact means the listed modifiers must be the only ones held. ModifierMatch Any ignores modifiers entirely. ModifierMatch CoarseOptional means Exact, except that the coarse step modifier is allowed on top.",
        "Bindings are tested in list order and the first enabled match wins, so put the more specific binding above the general one.",
        "RequiresEmptyStage true limits a binding to a press that lands on the grey stage rather than on the paper.",
        "Zoom limits and the wheel step live in Na__LayoutEditor__AppConfig__.json under LayoutEditor__Navigation__Config. This file owns which input triggers an action, that file owns how far and how fast it travels."
    ],

    "LayoutEditor__Guards__Config" : {
        "LayoutEditor__Guards__Description"             : "Elements inside the stage that keep their own input. A press or a wheel over one of these is left alone so a viewport canvas can drive its own camera and a panel control can be used.",
        "LayoutEditor__Guards__PointerIgnoreSelector"   : "input, select, button, textarea, canvas, [contenteditable=\"true\"]",
        "LayoutEditor__Guards__WheelIgnoreSelector"     : "canvas",
        "LayoutEditor__Guards__ContextMenuKeepSelector" : "input, select, button, textarea, [contenteditable=\"true\"]",
        "LayoutEditor__Guards__PaperSelector"           : ".na-le-paper"
    },

    "LayoutEditor__PointerBindings__Config" : {
        "LayoutEditor__PointerBindings__Description" : "Mouse and pen drags on the stage. The left button is deliberately left to the sheet tools unless a binding below claims it with a modifier or an empty-stage rule, which is the Lantern Designer rule: pan capture on a bare left button swallows the click before it reaches a dimension or a viewport.",
        "LayoutEditor__PointerBindings__List" : [
            {
                "Id"            : "Pan__MiddleOrRightDrag",
                "Label"         : "Pan the sheet (middle or right drag)",
                "Action"        : "Nav__Pan",
                "Enabled"       : true,
                "Buttons"       : [ "Middle", "Right" ],
                "Modifiers"     : [],
                "ModifierMatch" : "Any",
                "Note"          : "Lantern Designer parity. This is the shipped default."
            },
            {
                "Id"            : "Pan__SpaceLeftDrag",
                "Label"         : "Pan the sheet (hold space, left drag)",
                "Action"        : "Nav__Pan",
                "Enabled"       : false,
                "Buttons"       : [ "Left" ],
                "Modifiers"     : [ "Space" ],
                "ModifierMatch" : "Exact",
                "Note"          : "The CAD and Illustrator convention. Left click still edits while space is up."
            },
            {
                "Id"                 : "Pan__EmptyStageLeftDrag",
                "Label"              : "Pan the sheet (left drag on the grey stage)",
                "Action"             : "Nav__Pan",
                "Enabled"            : false,
                "Buttons"            : [ "Left" ],
                "Modifiers"          : [],
                "ModifierMatch"      : "Exact",
                "RequiresEmptyStage" : true,
                "Note"               : "Only fires when the press lands off the paper, so nothing on the sheet can be grabbed by accident."
            }
        ]
    },

